rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Validation Blueprint for Visitor
    function isValidVisitor(data) {
      return data.keys().hasAll(['name', 'createdAt']) && 
             data.keys().size() == 2 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.createdAt == request.time;
    }

    // Validation Blueprint for ContactMessage
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.createdAt == request.time;
    }

    // Collections
    match /visitors/{visitorId} {
      allow create: if isValidVisitor(incoming());
      
      // Allow read only to the user who created it
      allow read: if isSignedIn() && visitorId == request.auth.uid;
    }

    match /messages/{messageId} {
      // Anyone can create a message (we'll generate an ID on client)
      allow create: if isValidContactMessage(incoming());
      
      allow read: if false; // Only admin can read
    }
  }
}
