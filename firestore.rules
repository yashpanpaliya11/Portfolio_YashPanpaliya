rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Validation Blueprint for Visitor
    function isValidVisitor(data) {
      return data.keys().hasAll(['name', 'createdAt']) && 
             data.keys().size() == 2 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.createdAt == request.time;
    }

    // Collections
    match /visitors/{visitorId} {
      allow create: if isSignedIn() && 
                    visitorId == request.auth.uid && 
                    isValidVisitor(incoming());
      
      // Allow read only to the user who created it
      allow read: if isSignedIn() && visitorId == request.auth.uid;
    }
  }
}
